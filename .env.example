# Select exactly one provider: groq, gemini, openai, or anthropic.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Set LLM_API_KEY, or use GROQ_API_KEY when LLM_PROVIDER=groq.
LLM_API_KEY=
GROQ_API_KEY=

LLM_TIMEOUT_SECONDS=45
WEBSITE_TIMEOUT_SECONDS=12
MAX_RESPONSE_BYTES=2000000
MAX_CONTENT_CHARS=18000
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=256
